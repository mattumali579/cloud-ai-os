# syntax=docker/dockerfile:1
# Browser-capable worker image. Debian Chromium is available on amd64 and arm64,
# including Oracle A1; Playwright drives it through JOB_BROWSER_EXECUTABLE_PATH.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    CLOUDOS_ROOT=/app \
    JOB_BROWSER_EXECUTABLE_PATH=/usr/bin/chromium

RUN apt-get update \
    && apt-get install -y --no-install-recommends chromium curl fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 10001 cloudos \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin cloudos

WORKDIR /app
COPY pyproject.toml ./
COPY src/ ./src/
COPY config/ ./config/
COPY db/ ./db/
COPY scripts/ ./scripts/
RUN pip install --no-cache-dir . \
    && rm -rf build/ src/*.egg-info \
    && mkdir -p /app/data/browser-state /app/resumes/tailored \
    && chown -R cloudos:cloudos /app

USER cloudos
CMD ["python", "-m", "cloudos.worker"]
