# Copy to .env next to docker-compose.yml. Do not commit .env.
# Mock mode stores texts in Postgres and does not call Twilio.

MCTB_DB_PASSWORD=mctb
N8N_ENCRYPTION_KEY=replace-with-a-long-random-string
GENERIC_TIMEZONE=America/Chicago

TWILIO_MODE=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Public https origin of n8n, no trailing slash. Required for dial mode.
MCTB_PUBLIC_BASE_URL=http://localhost:5680

# Optional fan-out (Discord, Cloud AI OS owner-notify, an email gateway).
OWNER_ALERT_WEBHOOK_URL=
