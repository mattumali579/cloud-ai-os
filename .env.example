# Cloud AI OS — canonical environment contract (ARCHITECTURE.md §4)
# Copy to .env and fill in. NEVER commit .env.

ENVIRONMENT=local
INSTANCE_NAME=cloudos-local

# Local dev compose: postgres service. Oracle: Supabase connection string.
DATABASE_URL=postgresql://cloudos:cloudos@localhost:5432/cloudos

AGENT_API_TOKEN=change-me-long-random
AGENT_API_PORT=8080

WORKER_POLL_INTERVAL_SECONDS=5
WORKER_CONCURRENCY=2

# Retention — configurable, not hardcoded (§9 of the addendum)
AGENT_RUN_RETENTION_DAYS=14
EVENT_RETENTION_DAYS=7
COMPLETED_JOB_RETENTION_DAYS=7
FAILED_JOB_RETENTION_DAYS=30
RETENTION_DRY_RUN=false

# Zero-incremental-cost enforcement — do not change; the router hard-disables
# paid AI regardless. FIXED SUBSCRIPTION COST = owner-controlled;
# INCREMENTAL API COST = prohibited; SURPRISE AI SPEND = structurally impossible.
ALLOW_PAID_AI=false
ALLOW_PAID_INFRASTRUCTURE=false
MAX_DAILY_PAID_AI_USD=0
MAX_MONTHLY_PAID_AI_USD=0

# Subscription CLI providers (docs/SUBSCRIPTION_PROVIDERS.md).
# NEVER add ANTHROPIC_API_KEY / OPENAI_API_KEY / GEMINI_API_KEY here — provider
# subprocesses scrub them, and their presence anywhere is a billing risk.
SUBSCRIPTION_PROVIDERS=codex
AI_RETRY_AFTER_QUOTA_MINUTES=60
AI_RETRY_AFTER_AUTH_MINUTES=240
CLI_TIMEOUT_SECONDS=300
CLAUDE_CLI_BIN=claude
CODEX_CLI_BIN=codex
CODEX_WORKSPACE=../AI-Second-Brain
GEMINI_CLI_BIN=gemini
CLAUDE_CLI_MODEL=
# Headless/VM subscription credential for Claude (from: claude setup-token).
# This IS subscription-backed and deliberately not scrubbed.
# CLAUDE_CODE_OAUTH_TOKEN=

PRIVACY_CONFIG_PATH=config/privacy.yaml
SECOND_BRAIN_PATH=../AI-Second-Brain
SECOND_BRAIN_GIT_URL=

# Discord employee adapter (docs/DISCORD_CODEX_EMPLOYEES.md)
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_GUILD_ID=
DISCORD_API_URL=http://127.0.0.1:8080

# Higgsfield uses your Higgsfield account credits. Generation stays disabled
# until you explicitly opt in, and Discord still requires the word "confirm".
HIGGSFIELD_CLI_BIN=higgsfield
HIGGSFIELD_ALLOW_GENERATION=false
HIGGSFIELD_TIMEOUT_SECONDS=900

# Hostinger Email SMTP. Use the mailbox address as the username. Keep sending
# disabled until a draft has been previewed and its 12-character fingerprint
# has been confirmed in Discord.
HOSTINGER_SMTP_HOST=smtp.hostinger.com
HOSTINGER_SMTP_PORT=465
HOSTINGER_SMTP_USERNAME=
HOSTINGER_SMTP_PASSWORD=
EMAIL_FROM_NAME=
EMAIL_SEND_ENABLED=false
EMAIL_OUTBOX_PATH=../AI-Second-Brain/email_outbox

SUPABASE_DB_BUDGET_MB=500

# n8n webhook that fans out owner notifications (email/Discord). Empty = table only.
NOTIFY_WEBHOOK_URL=

# n8n service (compose)
N8N_BASIC_AUTH_USER=owner
N8N_BASIC_AUTH_PASSWORD=change-me
